{
  "contractVersion": "1.4",
  "id": "print/card-back",
  "useCase": "print",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "card"
  ],
  "proposal": "optional",
  "slots": {
    "name": {
      "required": true,
      "maxWords": 4,
      "maxChars": 32,
      "role": "h2"
    },
    "role": {
      "required": false,
      "maxWords": 7,
      "maxChars": 44,
      "role": "body"
    },
    "contact1": {
      "required": false,
      "maxWords": 5,
      "maxChars": 36,
      "role": "body"
    },
    "contact2": {
      "required": false,
      "maxWords": 5,
      "maxChars": 36,
      "role": "body"
    },
    "contact3": {
      "required": false,
      "maxWords": 5,
      "maxChars": 36,
      "role": "body"
    },
    "contact4": {
      "required": false,
      "maxWords": 5,
      "maxChars": 36,
      "role": "body"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "name",
    "role",
    "contact1",
    "contact2",
    "contact3",
    "contact4",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    },
    "align": {
      "values": [
        "start",
        "center"
      ],
      "default": "start"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "name.maxWords": {
      "to": null,
      "why": "a name is 4 words or fewer; titles go in the role"
    },
    "role.maxWords": {
      "to": null,
      "why": "the role is one line, 7 words or fewer"
    },
    "contact1.maxWords": {
      "to": null,
      "why": "a contact line is 5 words or fewer; one fact per line"
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
