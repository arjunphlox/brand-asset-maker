    "title.maxWords": {
      "to": null,
      "why": "the menu's title is 5 words or fewer (\"Today at the stall\"); rewrite it"
    },
    "item1.maxWords": {
      "to": null,
      "why": "an item is 7 words or fewer; the description goes in the note or on the counter"
    },
    "price1.maxChars": {
      "to": null,
      "why": "a price is 8 characters or fewer (\"₹2,699\", \"Free\"); rewrite it"
    },
    "note.maxWords": {
      "to": null,
      "why": "the note is one line of 20 words or fewer; cut it"
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
