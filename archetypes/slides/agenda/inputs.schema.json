    },
    "item1": {
      "required": true,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h3"
    },
    "item2": {
      "required": true,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h3"
    },
    "item3": {
      "required": true,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h3"
    },
    "item4": {
      "required": false,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h3"
    },
    "item5": {
      "required": false,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h3"
    },
    "item6": {
      "required": false,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h3"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "page": {
      "required": false,
      "maxWords": 3,
      "maxChars": 7,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "title",
    "item1",
    "item2",
    "item3",
    "item4",
    "item5",
    "item6",
    "footer",
    "page",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "item3.required": {
      "to": "slides/bullets",
      "why": "an agenda is three to six items; with two, say them as points or skip the agenda"
    },
    "item1.maxWords": {
      "to": null,
      "why": "an agenda item is a section name, 6 words or fewer"
    },
    "title.maxWords": {
      "to": null,
      "why": "the agenda title is 4 words or fewer (\"Today\", \"What we cover\")"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
