{
  "contractVersion": "1.4",
  "id": "slides/bullets",
  "useCase": "slides",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "16:9"
  ],
  "proposal": "optional",
  "slots": {
    "title": {
      "required": true,
      "maxWords": 8,
      "maxChars": 50,
      "role": "h2"
    },
    "point1": {
      "required": true,
      "maxWords": 12,
      "maxChars": 80,
      "role": "body"
    },
    "point2": {
      "required": true,
      "maxWords": 12,
      "maxChars": 80,
      "role": "body"
    },
    "point3": {
      "required": true,
      "maxWords": 12,
      "maxChars": 80,
      "role": "body"
    },
    "point4": {
      "required": false,
      "maxWords": 12,
      "maxChars": 80,
      "role": "body"
    },
    "point5": {
      "required": false,
      "maxWords": 12,
      "maxChars": 80,
      "role": "body"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "page": {
      "required": false,
      "maxWords": 3,
      "maxChars": 7,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "title",
    "point1",
    "point2",
    "point3",
    "point4",
    "point5",
    "footer",
    "page",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "point3.required": {
      "to": "slides/two-column",
      "why": "two points read better side by side"
    },
    "point1.maxWords": {
      "to": null,
      "why": "a point is 12 words or fewer; cut it, and say the rest out loud"
    },
    "point2.maxWords": {
      "to": null,
      "why": "a point is 12 words or fewer; cut it, and say the rest out loud"
    },
    "point3.maxWords": {
      "to": null,
      "why": "a point is 12 words or fewer; cut it, and say the rest out loud"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
