      "scale": "bars"
    },
    "label5": {
      "required": false,
      "maxWords": 4,
      "maxChars": 24,
      "role": "body"
    },
    "value5": {
      "required": false,
      "maxWords": 1,
      "maxChars": 6,
      "role": "data-snippet",
      "scale": "bars"
    },
    "label6": {
      "required": false,
      "maxWords": 4,
      "maxChars": 24,
      "role": "body"
    },
    "value6": {
      "required": false,
      "maxWords": 1,
      "maxChars": 6,
      "role": "data-snippet",
      "scale": "bars"
