  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "value1.scale": {
      "to": null,
      "why": "every value is one number in the same unit, zero or more; fix the row, never the bar"
    },
    "value2.scale": {
      "to": null,
      "why": "every value is one number in the same unit, zero or more; fix the row, never the bar"
    },
    "value2.required": {
      "to": "slides/stat",
      "why": "one number is not a chart; say it on the stat slide"
    },
    "label1.maxWords": {
      "to": null,
      "why": "a bar label is 4 words or fewer"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
