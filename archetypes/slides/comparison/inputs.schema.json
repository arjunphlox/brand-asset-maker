{
  "contractVersion": "1.4",
  "id": "slides/comparison",
  "useCase": "slides",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "16:9"
  ],
  "proposal": "optional",
  "slots": {
    "title": {
      "required": false,
      "maxWords": 8,
      "maxChars": 50,
      "role": "h2"
    },
    "leftLabel": {
      "required": true,
      "maxWords": 3,
      "maxChars": 20,
      "role": "label"
    },
    "left": {
      "required": true,
      "maxWords": 16,
      "maxChars": 100,
      "role": "h3"
    },
    "rightLabel": {
      "required": true,
      "maxWords": 3,
      "maxChars": 20,
      "role": "label"
    },
    "right": {
      "required": true,
      "maxWords": 16,
      "maxChars": 100,
      "role": "h3"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "page": {
      "required": false,
      "maxWords": 3,
      "maxChars": 7,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "right",
    "left",
    "rightLabel",
    "leftLabel",
    "title",
    "footer",
    "page",
    "logo"
  ],
  "appear": {
    "words": [
      "credible",
      "simple"
    ],
    "why": "Two things set side by side: fair and easy to compare."
  },
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    },
    "emphasis": {
      "values": [
        "right",
        "none"
      ],
      "default": "right"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "left.maxWords": {
      "to": "slides/two-column",
      "why": "a panel is one line of 16 words or fewer; with paragraphs, use two columns"
    },
    "right.maxWords": {
      "to": "slides/two-column",
      "why": "a panel is one line of 16 words or fewer; with paragraphs, use two columns"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
