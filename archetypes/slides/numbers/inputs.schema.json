    },
    "accent": {
      "values": [
        "numbers",
        "none"
      ],
      "default": "numbers"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "number1.maxChars": {
      "to": "slides/stat",
      "why": "a number over 5 characters needs the room of the stat slide"
