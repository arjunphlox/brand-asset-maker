  "hierarchy": [
    "number1",
    "number2",
    "number3",
    "label1",
    "label2",
    "label3",
    "title",
    "footer",
    "page",
    "logo"
  ],
  "appear": {
    "words": [
      "credible",
      "simple"
    ],
    "why": "A few numbers together: believed, easy to take in."
  },
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
