    "number2.maxChars": {
      "to": "slides/stat",
      "why": "a number over 5 characters needs the room of the stat slide"
    },
    "number3.maxChars": {
      "to": "slides/stat",
      "why": "a number over 5 characters needs the room of the stat slide"
    },
    "number3.required": {
      "to": "slides/stat",
      "why": "the numbers slide is three; with one, use the stat slide; with two, two stat slides or a chart"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
