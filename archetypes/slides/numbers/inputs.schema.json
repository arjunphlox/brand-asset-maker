      "maxChars": 48,
      "role": "body"
    },
    "number2": {
      "required": true,
      "maxWords": 2,
      "maxChars": 5,
      "role": "data-snippet"
    },
    "label2": {
      "required": true,
      "maxWords": 8,
      "maxChars": 48,
      "role": "body"
    },
    "number3": {
      "required": true,
      "maxWords": 2,
      "maxChars": 5,
      "role": "data-snippet"
    },
    "label3": {
      "required": true,
      "maxWords": 8,
      "maxChars": 48,
      "role": "body"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
