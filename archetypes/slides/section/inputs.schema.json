{
  "contractVersion": "1.4",
  "id": "slides/section",
  "useCase": "slides",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "16:9"
  ],
  "proposal": "optional",
  "slots": {
    "number": {
      "required": true,
      "maxWords": 1,
      "maxChars": 3,
      "role": "data-snippet"
    },
    "title": {
      "required": true,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h1"
    },
    "kicker": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "page": {
      "required": false,
      "maxWords": 3,
      "maxChars": 7,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "title",
    "number",
    "kicker",
    "footer",
    "page",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "ink"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "number.maxChars": {
      "to": null,
      "why": "a section number is 3 characters or fewer (\"01\"); a deck with more sections needs regrouping"
    },
    "title.maxWords": {
      "to": null,
      "why": "a section title is 6 words or fewer, the name the agenda uses"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
