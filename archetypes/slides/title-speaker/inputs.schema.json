{
  "contractVersion": "1.4",
  "id": "slides/title-speaker",
  "useCase": "slides",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "16:9"
  ],
  "proposal": "optional",
  "slots": {
    "title": {
      "required": true,
      "maxWords": 10,
      "maxChars": 60,
      "role": "h1"
    },
    "speaker": {
      "required": true,
      "maxWords": 4,
      "maxChars": 32,
      "role": "h3"
    },
    "role": {
      "required": true,
      "maxWords": 8,
      "maxChars": 56,
      "role": "body"
    },
    "event": {
      "required": false,
      "maxWords": 6,
      "maxChars": 40,
      "role": "label"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "page": {
      "required": false,
      "maxWords": 3,
      "maxChars": 7,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "title",
    "speaker",
    "role",
    "event",
    "footer",
    "page",
    "logo"
  ],
  "appear": {
    "words": [
      "credible",
      "refined"
    ],
    "why": "Who is talking: worth listening to, well made."
  },
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "title.maxWords": {
      "to": null,
      "why": "a talk title is 10 words or fewer; rewrite it"
    },
    "speaker.required": {
      "to": "slides/title",
      "why": "no speaker to name: use the title slide"
    },
    "role.maxWords": {
      "to": null,
      "why": "the role is one line, 8 words or fewer (\"Head roaster, Kadri\")"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
