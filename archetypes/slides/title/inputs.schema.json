{
  "contractVersion": "1.4",
  "id": "slides/title",
  "useCase": "slides",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "16:9"
  ],
  "proposal": "optional",
  "slots": {
    "title": {
      "required": true,
      "maxWords": 10,
      "maxChars": 60,
      "role": "h1"
    },
    "subtitle": {
      "required": false,
      "maxWords": 16,
      "maxChars": 100,
      "role": "body"
    },
    "kicker": {
      "required": false,
      "maxWords": 6,
      "maxChars": 40,
      "role": "label"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "page": {
      "required": false,
      "maxWords": 3,
      "maxChars": 7,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "title",
    "subtitle",
    "kicker",
    "footer",
    "page",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    },
    "align": {
      "values": [
        "start",
        "center"
      ],
      "default": "start"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "title.maxWords": {
      "to": null,
      "why": "a deck title is 10 words or fewer; move the rest to the subtitle"
    },
    "title.maxChars": {
      "to": null,
      "why": "a deck title is 60 characters or fewer; move the rest to the subtitle"
    },
    "subtitle.maxWords": {
      "to": null,
      "why": "the subtitle is one line of 16 words or fewer; say the rest out loud"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
