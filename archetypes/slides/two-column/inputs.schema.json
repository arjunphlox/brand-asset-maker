{
  "contractVersion": "1.4",
  "id": "slides/two-column",
  "useCase": "slides",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "16:9"
  ],
  "proposal": "optional",
  "slots": {
    "title": {
      "required": true,
      "maxWords": 8,
      "maxChars": 50,
      "role": "h2"
    },
    "leftLabel": {
      "required": true,
      "maxWords": 4,
      "maxChars": 28,
      "role": "label"
    },
    "left": {
      "required": true,
      "maxWords": 40,
      "maxChars": 240,
      "role": "body"
    },
    "rightLabel": {
      "required": true,
      "maxWords": 4,
      "maxChars": 28,
      "role": "label"
    },
    "right": {
      "required": true,
      "maxWords": 40,
      "maxChars": 240,
      "role": "body"
    },
    "footer": {
      "required": false,
      "maxWords": 8,
      "maxChars": 48,
      "role": "label"
    },
    "page": {
      "required": false,
      "maxWords": 3,
      "maxChars": 7,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "title",
    "leftLabel",
    "left",
    "rightLabel",
    "right",
    "footer",
    "page",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "left.maxWords": {
      "to": null,
      "why": "a column is 40 words or fewer; cut it, or give each side its own slide"
    },
    "right.maxWords": {
      "to": null,
      "why": "a column is 40 words or fewer; cut it, or give each side its own slide"
    },
    "left.maxChars": {
      "to": null,
      "why": "a column is 240 characters or fewer"
    },
    "right.maxChars": {
      "to": null,
      "why": "a column is 240 characters or fewer"
    },
    "footer.maxWords": {
      "to": null,
      "why": "the footer is the deck title, 8 words or fewer; use the short title"
    },
    "page.maxChars": {
      "to": null,
      "why": "the page slot is a page number such as \"3\" or \"3 / 12\""
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
