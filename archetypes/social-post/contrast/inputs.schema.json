{
  "contractVersion": "1.4",
  "id": "social-post/contrast",
  "useCase": "social-post",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "1:1",
    "4:5"
  ],
  "proposal": "optional",
  "slots": {
    "claim": {
      "required": true,
      "maxWords": 10,
      "maxChars": 60,
      "role": "h2"
    },
    "counter": {
      "required": true,
      "maxWords": 10,
      "maxChars": 60,
      "role": "h2"
    },
    "tagline": {
      "required": false,
      "maxWords": 6,
      "maxChars": 32,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "claim",
    "counter",
    "tagline",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    },
    "offset": {
      "values": [
        "stagger",
        "stack"
      ],
      "default": "stagger"
    },
    "claim": {
      "values": [
        "plain",
        "outline"
      ],
      "default": "plain"
    },
    "rule": {
      "values": [
        "none",
        "hairline"
      ],
      "default": "none"
    },
    "join": {
      "values": [
        "panel",
        "inline"
      ],
      "default": "panel"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "counter.required": {
      "to": "social-post/headline",
      "why": "one sentence is not a contrast; say it as a headline"
    },
    "claim.required": {
      "to": "social-post/headline",
      "why": "one sentence is not a contrast; say it as a headline"
    },
    "claim.maxWords": {
      "to": null,
      "why": "the claim is one short sentence, 10 words or fewer; rewrite it, never shrink the type"
    },
    "claim.maxChars": {
      "to": null,
      "why": "the claim is one short sentence, 60 characters or fewer; rewrite it, never shrink the type"
    },
    "counter.maxWords": {
      "to": null,
      "why": "the counter is one short sentence, 10 words or fewer; rewrite it, never shrink the type"
    },
    "counter.maxChars": {
      "to": null,
      "why": "the counter is one short sentence, 60 characters or fewer; rewrite it, never shrink the type"
    },
    "tagline.maxWords": {
      "to": null,
      "why": "the tagline is a sign-off, 6 words or fewer; rewrite it or leave it out"
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    },
    "tagline.maxChars": {
      "to": null,
      "why": "the tagline is a sign-off on one line, 32 characters or fewer; rewrite it or leave it out"
    }
  }
}
