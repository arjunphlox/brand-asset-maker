{
  "contractVersion": "1.0",
  "id": "social-post/headline",
  "useCase": "social-post",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-ND-4.0",
  "tier": "sample",
  "slots": {
    "headline": {
      "required": true,
      "maxWords": 8,
      "maxChars": 64,
      "role": "h1"
    },
    "kicker": {
      "required": false,
      "maxWords": 4,
      "maxChars": 28,
      "role": "label"
    },
    "cta": {
      "required": false,
      "maxWords": 3,
      "maxChars": 20,
      "role": "label"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "headline",
    "kicker",
    "cta",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    },
    "align": {
      "values": [
        "start",
        "center"
      ],
      "default": "start"
    },
    "size": {
      "values": [
        1,
        2
      ],
      "default": 1
    },
    "mark": {
      "values": [
        "bar",
        "none"
      ],
      "default": "bar"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "headline.maxWords": {
      "to": null,
      "why": "rewrite the line; there is no simpler archetype"
    },
    "cta.maxWords": {
      "to": null,
      "why": "a call to action is 3 words or fewer and starts with a verb (\"Find us Saturday\"); rewrite it"
    },
    "cta.maxChars": {
      "to": null,
      "why": "a call to action is 3 words or fewer and starts with a verb (\"Find us Saturday\"); rewrite it"
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
