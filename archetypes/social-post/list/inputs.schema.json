{
  "contractVersion": "1.4",
  "id": "social-post/list",
  "useCase": "social-post",
  "author": "HueGrid Studio",
  "license": "CC-BY-NC-SA-4.0",
  "tier": "sample",
  "ratios": [
    "1:1",
    "4:5"
  ],
  "proposal": "optional",
  "slots": {
    "title": {
      "required": true,
      "maxWords": 6,
      "maxChars": 40,
      "role": "h1"
    },
    "item1": {
      "required": true,
      "maxWords": 6,
      "maxChars": 36,
      "role": "h3"
    },
    "item2": {
      "required": true,
      "maxWords": 6,
      "maxChars": 36,
      "role": "h3"
    },
    "item3": {
      "required": true,
      "maxWords": 6,
      "maxChars": 36,
      "role": "h3"
    },
    "logo": {
      "required": true,
      "kind": "asset"
    }
  },
  "hierarchy": [
    "title",
    "item1",
    "item2",
    "item3",
    "logo"
  ],
  "variation": {
    "scheme": {
      "values": [
        "paper",
        "ink",
        "accent"
      ],
      "default": "paper"
    },
    "accent": {
      "values": [
        "numbers",
        "last",
        "none"
      ],
      "default": "numbers"
    },
    "style": {
      "values": [
        "numbered",
        "stacked"
      ],
      "default": "numbered"
    }
  },
  "checks": {
    "contrast": true,
    "min-text": true,
    "safe-zone": true,
    "overflow": true,
    "element-count": true,
    "token-colors": true,
    "logo-integrity": true,
    "logo-visible": true,
    "font-loaded": true,
    "role-face": true,
    "budget": true
  },
  "fallbacks": {
    "title.maxWords": {
      "to": null,
      "why": "the title names the list, 6 words or fewer; rewrite it"
    },
    "item1.maxWords": {
      "to": null,
      "why": "an item is one short line, 6 words or fewer; cut it to the point"
    },
    "item2.maxWords": {
      "to": null,
      "why": "an item is one short line, 6 words or fewer; cut it to the point"
    },
    "item3.maxWords": {
      "to": null,
      "why": "an item is one short line, 6 words or fewer; cut it to the point"
    },
    "item3.required": {
      "to": "social-post/headline",
      "why": "the list layout is three things; with fewer, say the strongest one as a headline"
    },
    "item2.required": {
      "to": "social-post/headline",
      "why": "the list layout is three things; with fewer, say the strongest one as a headline"
    },
    "logo.required": {
      "to": null,
      "why": "refuse to render; intake is incomplete"
    }
  }
}
